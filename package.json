{
  "name": "gestion-solicitudes-aprobaciones",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"node --import tsx apps/api/src/server.ts\" \"node node_modules/vite/bin/vite.js apps/web\"",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "start": "node apps/api/dist/server.js --serve-web",
    "db:local": "node scripts/postgres-local.mjs",
    "db:check": "node --env-file-if-exists=.env --import tsx apps/api/src/persistence/cli.ts check",
    "db:migrate": "node --env-file-if-exists=.env --import tsx apps/api/src/persistence/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx apps/api/src/persistence/cli.ts seed",
    "db:check:test": "node --env-file-if-exists=.env --import tsx apps/api/src/persistence/cli.ts check --test",
    "db:migrate:test": "node --env-file-if-exists=.env --import tsx apps/api/src/persistence/cli.ts migrate --test",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config apps/api/vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "concurrently": "10.0.7",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "tsx": "4.23.15",
    "vite": "8.3.8"
  },
  "packageManager": "npm@11.19.1"
}
